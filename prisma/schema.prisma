// Eurostar backend — database schema.
// This describes every "drawer" of information the app remembers.
//
// Production uses PostgreSQL (Render's built-in database). DATABASE_URL points
// at it. The models are database-agnostic, so the same schema also works on
// SQLite for quick local testing if you switch the provider back.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// PEOPLE & LOGIN
// ---------------------------------------------------------------------------

// A person who can log in: a customer, a sales rep, or a back-office staffer.
model User {
  id           String   @id @default(cuid())
  role         String // "customer" | "rep" | "office"
  name         String
  phone        String?  @unique // customers log in with phone + OTP
  gstin        String? // captured at first customer sign-up
  userId       String?  @unique // login id for rep/office (e.g. "REP001", "office")
  passwordHash String? // set for rep/office only
  repId        String? // if this user IS a rep, their public rep id
  active       Boolean  @default(true)
  // Rep-only settings, managed from the CRM's "Reps & commission" screen.
  region       String? // territory, e.g. "Gujarat"
  phoneNote    String? // display phone shown in the reps table (phone is unique/login)
  commissionPct Float?  @default(4) // blended commission %, e.g. 4 = 4%
  monthlyTarget Int?    @default(50) // new-customers target per month (min 50)
  asmId        String? // escalation contact (Area Sales Manager)
  headId       String? // escalation contact (Sales Head)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  // Customers this user (a rep) owns, via the Customer.rep relation.
  customersAsRep Customer[] @relation("RepCustomers")
  ordersTaken    Order[]    @relation("OrderTakenBy")
  paymentsTaken  Payment[]  @relation("PaymentReceivedBy")
  paymentsVerified Payment[] @relation("PaymentVerifiedBy")
  rfqsQuoted     Rfq[]      @relation("RfqQuotedBy")
}

// "Remember me" tokens — let a user stay logged in without retyping.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// One-time codes sent by SMS for customer login.
model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

// ---------------------------------------------------------------------------
// CUSTOMERS (the businesses that buy)
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  code      String   @unique // human-friendly code, e.g. "CUST-1042"
  name      String // company or contact name
  contact     String? // contact person, e.g. "Kiran Mehta"
  email       String?
  phone       String?
  city        String?
  gstin       String?
  pincode     String? // field capture: the shop's PIN code
  shipAddress String? // delivery address (profile "Addresses" tab)
  billAddress String? // billing address; null = same as shipping
  gstinNorm String? // normalised GSTIN for dedupe (CRM customer master)
  // Filled by a rep signing up a shop in person (CRM → My customers → Add):
  // a photo of the shopfront and the lat,lng where it was taken.
  shopPhoto   String? // data URL of the shopfront photo
  geo         String? // "18.52040, 73.85670"
  terms     String   @default("cash") // "cash" | "15" | "30" | "45" | "60"
  repUserId String? // which rep owns this customer
  rep       User?    @relation("RepCustomers", fields: [repUserId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carts    Cart[]
  orders   Order[]
  rfqs     Rfq[]
  payments Payment[]

  @@index([repUserId])
  @@index([gstinNorm])
}

// ---------------------------------------------------------------------------
// CATALOG (what is for sale)
//
// The catalogue and its live price calculation live in the frontend
// (app/data.jsx) and are served by the API from a static module
// (src/data/catalog.ts) — 28 real categories with their unit-of-sale.
// The only *stateful* catalogue data the backend owns is per-variant
// sold-out flags, keyed exactly like the client ("cat|grade|color|shape|size").
// ---------------------------------------------------------------------------

model SoldOut {
  key       String   @id // "cat|grade|color|shape|size" (matches client soldOutKey)
  soldOut   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// CARTS & ORDERS
// ---------------------------------------------------------------------------

model Cart {
  id         String   @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  repUserId  String?
  personaId  String? // client-side owner key ("eurostar-drafts-<personaId>")
  status     String   @default("active") // "active" | "confirmed"
  discount   Int      @default(0) // % off, set by back office when negotiating a cart
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lines CartLine[]

  @@index([customerId])
  @@index([personaId])
}

model CartLine {
  id         String  @id @default(cuid())
  cartId     String
  cart       Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  skuId      String?
  name       String? // product label as shown in the cart / editor
  categoryKey String?
  grade      String?
  colour     String?
  shape      String?
  size       String?
  unit       String
  qty        Int
  unitPrice  Int
  lineTotal  Int

  @@index([cartId])
}

model Order {
  id         String   @id // client id (e.g. "SO-24987") or server "ESO-2026-0001"
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  repUserId  String?
  takenBy    User?    @relation("OrderTakenBy", fields: [repUserId], references: [id])

  // Denormalised snapshot fields the CRM/back-office order stream reads directly
  // (mirrors the object the client wrote to eurostar-crm-incoming-orders).
  customerName String? // "customer"
  customerCode String? // "code"
  city         String?
  repName      String? // "rep"
  repId        String?

  subtotal        Int
  tax             Int // GST 3% (0 for export)
  shipping        Int // courier: free over ₹1000 else ₹300
  insurance       Int      @default(0)
  grand           Int // "value" in the client order object
  isExport        Boolean  @default(false)
  paid            Boolean  @default(false)
  dispatchBy      DateTime?
  dispatchByLabel String? // e.g. "Wed, 17 Jul" (as the client stores it)
  courier         String? // CRM pipeline: assigned courier
  track           String? // CRM pipeline: tracking / AWB number
  status          String   @default("pending") // pending|confirmed|packed|shipped|delivered|cancelled
  source          String   @default("Sales App")
  queuedOffline   Boolean  @default(false)
  clientTs        String? // client Date.now() epoch ms (kept as string; can exceed 32-bit)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines    OrderLine[]
  payments Payment[]

  @@index([customerId])
  @@index([status])
}

model OrderLine {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuId         String?
  categoryKey   String?
  grade         String?
  colour        String?
  shape         String?
  size          String?
  unit          String
  qty           Int
  unitPrice     Int
  priceOverride Int? // office may charge higher than list
  overrideBy    String? // audit: who overrode the price
  lineTotal     Int

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// PAYMENTS
// ---------------------------------------------------------------------------

model Payment {
  id           String   @id // "PAY-APP-<orderId>" (matches client) or generated
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id])
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  custId       String? // client "custId"
  custCode     String?
  custName     String?
  mode         String // "upi" | "card" | "netbanking" | "neft" | "qr"
  amount       Int
  utr          String? // bank/UPI reference number
  date         String? // "YYYY-MM-DD" (as the client stores it)
  by           String? // who collected the payment
  contact      String?
  img          String? // receipt image dataURL | null
  status       String   @default("confirmed") // pending|confirmed|failed
  source       String   @default("Sales App")
  receivedById String?
  receivedBy   User?    @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  // Verification audit trail (who confirmed/rejected, when, and why).
  verifiedById String?
  verifiedBy   User?    @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?
  rejectReason String?
  loggedAt     DateTime @default(now())

  @@index([orderId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// RFQ (request for quote — ₹10,000 minimum)
// ---------------------------------------------------------------------------

model Rfq {
  id         String   @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  value      Int
  status     String   @default("open") // "open" | "answered" | "quoted" | "closed"
  lines      String // JSON-encoded list of requested items (SQLite has no JSON type)
  assignedRep String? // repId the CRM routed this enquiry to
  city       String?
  detail     String? // JSON: product/size/qty/weight/quality/contactName/contact/special/image
  // The quote the office sends back for this enquiry (status becomes "quoted").
  quoteAmount Int? // ₹ quoted, total for the requested quantity
  quoteNote   String? // validity, terms, packing note shown with the quote
  quotedAt    DateTime?
  quotedById  String? // staff user who sent the quote
  quotedBy    User?    @relation("RfqQuotedBy", fields: [quotedById], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// MIRA ASSISTANT
// ---------------------------------------------------------------------------

model AssistantConfig {
  id           String   @id @default("default")
  enabled      Boolean  @default(true)
  instructions String   @default("")
  rules        String   @default("")
  knowledge    String   @default("")
  examples     String   @default("")
  updatedAt    DateTime @updatedAt
}

model ChatLog {
  id        String   @id @default(cuid())
  sessionId String
  app       String   @default("sales") // which surface: "sales" | "crm" | "lms"
  role      String // "user" | "assistant"
  message   String
  who       String? // company / persona name
  contact   String?
  cust      String? // customer code
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([app])
}

model Notification {
  id         String   @id @default(cuid())
  customerId String?
  kind       String   @default("shipment") // "shipment" | "info"
  orderId    String? // shipment notices reference an order
  courier    String?
  track      String? // tracking number / AWB
  title      String? // used by "info" notices
  body       String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// COUNTERS (for human-friendly ids like ESO-2026-0001)
// ---------------------------------------------------------------------------

model Counter {
  key   String @id
  value Int    @default(0)
}

// ---------------------------------------------------------------------------
// PHASE 1: shared resources for CRM / LMS / Admin
// ---------------------------------------------------------------------------

// A sales rep record in the CRM (ingested from LMS "Onboard to CRM").
// Distinct from a User(role=rep) login — this is the CRM's rep/commission record.
model Rep {
  id             String   @id @default(cuid())
  repId          String?  @unique // public rep id, e.g. "REP-204"
  name           String
  city           String?
  state          String?
  source         String? // where the hire came from (LMS)
  tier           String? // e.g. "Gold partner"
  commissionRate Float    @default(0) // fraction, e.g. 0.05 = 5%
  hiredAt        DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Escalation contacts shown to reps (their ASM and Sales Head). Managed on the
// CRM "Reps & commission" screen; a rep points at one via User.asmId/headId.
model EscalationContact {
  id        String   @id @default(cuid())
  name      String
  role      String // "asm" (Area Sales Manager) | "head" (Sales Head)
  phone     String
  createdAt DateTime @default(now())
}

// Field-sales attendance: a rep checks in/out with their phone's GPS.
model CheckIn {
  id        String   @id @default(cuid())
  userId    String // the rep's User.id
  repId     String? // public rep id (e.g. REP-204)
  repName   String?
  type      String // "in" | "out"
  lat       Float
  lng       Float
  accuracy  Float? // GPS accuracy in metres
  address   String? // optional label/place the rep is visiting
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Morning attendance: a rep marks themselves present for the day with a photo.
// Distinct from CheckIn (that is per-customer GPS field visits). One row per
// rep per day; a day with no row is an absence.
model Attendance {
  id        String   @id @default(cuid())
  userId    String // the rep's User.id
  repId     String // public rep id (e.g. REP-204)
  repName   String?
  date      String // "YYYY-MM-DD" — the day marked present
  status    String   @default("present") // "present" | "leave"
  photo     String? // data URL of the check-in selfie/shopfront
  time      String? // "09:14 am" display time
  createdAt DateTime @default(now())

  @@unique([repId, date])
  @@index([date])
}

// A rep's customer visit: one row, opened at check-in and closed at check-out,
// each with GPS. The admin Field Visits screen reads these. Distinct from
// CheckIn (raw in/out points) and Attendance (daily present/absent).
model FieldVisit {
  id         String   @id @default(cuid())
  userId     String // the rep's User.id
  repId      String // public rep id
  repName    String?
  custId     String // customer code the rep visited
  custName   String?
  custCity   String?
  custMobile String?
  day        String // "YYYY-MM-DD" of the check-in
  checkInAt  DateTime @default(now())
  inLat      Float?
  inLng      Float?
  inAcc      Float?
  inSource   String? // "gps" | "approx"
  checkOutAt DateTime?
  outLat     Float?
  outLng     Float?
  createdAt  DateTime @default(now())

  @@index([repId, day])
  @@index([day])
}

// LMS recruitment pipeline candidate.
model Candidate {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  city      String?
  state     String?
  source    String? // Google / LinkedIn / Instagram / ...
  stage     String   @default("applied") // applied|screening|training|test|recommended|hired|rejected
  score     Int? // screening/test score
  exp       String? // experience note (e.g. "4 yrs")
  repId     String? // assigned rep id once hired
  candId    String?  @unique // display id, e.g. "EC-1001"
  // Everything the LMS UI tracks that isn't a top-level column: screening
  // result/notes/rating, test attempts, watched videos, unlock dates,
  // temp password, onboarding KYC/bank/offer. Stored as JSON so the whole
  // candidate round-trips without a column per field.
  data      String? // JSON blob of the rich candidate state
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  practices Practice[]

  @@index([stage])
}

// Per-candidate practice checklist state (maps to lms-practice-<candId>-<app>).
model Practice {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  app         String // which app's checklist
  data        String // JSON-encoded tick state
  updatedAt   DateTime  @updatedAt

  @@unique([candidateId, app])
}

// LMS training module + its practice checklist definition.
model TrainingModule {
  id        String   @id @default(cuid())
  title     String
  summary   String?
  videoUrl  String? // link to the training video (hosted externally)
  checklist String   @default("[]") // JSON-encoded list of checklist items
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Rep broadcast announcement (single active banner). Written by CRM/Admin,
// shown once-a-day to reps in the Sales app.
model Announcement {
  id          String   @id @default("default")
  active      Boolean  @default(false)
  image       String? // banner image URL / dataURL
  title       String?
  message     String?
  badge       String?
  windowStart DateTime?
  windowEnd   DateTime?
  updatedAt   DateTime @updatedAt
}

// Sales leads (purchased/uploaded lists, single adds). The CRM "Leads" screen
// uploads, matches against existing customers (flagged), approves/assigns to
// reps, and works the pipeline stage. Client supplies the id (LD-…), so create
// is an upsert.
model Lead {
  id        String   @id
  name      String
  city      String   @default("")
  mobile    String   @default("")
  gst       String   @default("")
  rep       String   @default("") // assigned repId, or "" when unassigned
  stage     Int      @default(1)
  followUp  String   @default("")
  assigned  Boolean  @default(false)
  note      String   @default("")
  flagged   Boolean  @default(false) // matched an existing customer, held for review
  flagName  String   @default("")
  flagBy    String   @default("")
  // Set when the lead reaches "Met & added customer" (stage 2) and a Customer
  // record is created from it. Stops a second customer being made if the lead
  // bounces back and forth across that stage.
  customerCode String @default("")
  createdAt DateTime @default(now())

  @@index([flagged])
  @@index([rep])
}

// Franchise enquiries from the Sales App "Join Franchise" form. Read by the CRM
// "Franchise Requests" screen.
model Franchise {
  id        String   @id @default(cuid())
  name      String
  firm      String   @default("")
  city      String   @default("")
  mobile    String   @default("")
  invest    String   @default("")
  exp       String   @default("") // existing jewellery trade answer
  geo       String   @default("") // proposed store location / map link
  area      String   @default("") // proposed store area (sq ft)
  floor     String   @default("")
  plans     String   @default("")
  status    String   @default("new") // new | contacted | closed
  createdAt DateTime @default(now())

  @@index([status])
}

// Generic key/value store (JSON as text) for admin content overlays:
// catalog extra colours/shapes, category/shape thumbnails, splash pop-up,
// category order, Mira images/enabled flags, language default, etc.
model Setting {
  key       String   @id
  value     String // JSON-encoded
  updatedAt DateTime @updatedAt
}

// The storefront catalogue. Was a static file (src/data/catalog.ts), which is
// why the Admin app's "create category" had nowhere to save. Seeded from that
// same file, so the original 28 categories are preserved verbatim.
// The SKUs behind the catalogue. Was a static file (src/data/products.ts), so
// the Admin app's "Save pricing" and "Commit N products" had nowhere to write.
// Seeded from that file, so the original 18 SKUs are preserved verbatim.
model Product {
  id         String  @id // e.g. "EUR-MOI-0107"
  name       String
  cat        String // Category.key — not a FK: a SKU may outlive a category rename
  tone       String  @default("")
  shape      String  @default("")
  size       String  @default("")
  clarity    String  @default("")
  price      Int // wholesale rate in whole rupees
  unit       String  @default("per pc") // per pc | per ct | per strip | per set…
  moq        Int     @default(1)
  stock      String  @default("in") // in | low | out
  stockCount Int     @default(0)
  // Packet-sold categories only: how many pieces are in one packet of this
  // size. Null means "use the category default" — the storefront's chart value.
  pcsPerPacket Int?
  badge      String?
  desc       String?
  hidden     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cat])
}

model Category {
  key       String  @id // url-safe slug, e.g. "moissanite"
  name      String
  short     String
  blurb     String  @default("")
  unit      String // pc | ct | pkt | strip — unit of sale
  origin    String  @default("")
  skipGrade Boolean @default(false)
  count     Int     @default(0) // SKU count shown on the category card
  sortOrder Int     @default(0)
  hidden    Boolean @default(false) // "Hidden from app" toggle in Admin

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}
