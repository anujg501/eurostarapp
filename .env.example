# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values.
#   cp .env.example .env
# The ".env" file is private and must NEVER be committed to git.
# ---------------------------------------------------------------------------

# Which port the backend listens on
PORT=4000

# Where the website is allowed to call the backend from (comma-separated).
# Add your live website address here when you go online.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database connection (PostgreSQL).
# In production this is set automatically by Render. For local development, point
# it at a local Postgres, e.g.:
#   DATABASE_URL="postgresql://user:password@localhost:5432/eurostar"
DATABASE_URL="postgresql://localhost:5432/eurostar"

# Secret keys used to keep logins safe. Use long random text in production.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-access
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP (the one-time code sent by SMS at customer login).
# In development we DO NOT send real SMS — the code is shown in the server logs
# and returned by the API so you can test. Set to "false" to require a real
# SMS provider (plug one in inside src/services/otp.ts).
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# Temporary demo stand-in for real SMS: when set, customer login accepts this
# one code for every phone number. The code is NOT returned by the API, so a
# stranger cannot discover it just by calling /auth/otp/request — but anyone who
# is told it can sign in as any customer.
# CLEAR THIS as soon as TWILIO_* / MSG91 credentials are in place.
OTP_FIXED_CODE=

# Company UPI details for the "pay by QR" feature (back office / rep).
COMPANY_UPI_ID=eurostar@okhdfcbank
COMPANY_UPI_NAME=Eurostar Technologies Inc.

# Razorpay. The Key ID is public (used by the checkout box); the Key Secret and
# the Webhook Secret are private and must only ever live on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Copy this from the Razorpay dashboard when you create the webhook. It is what
# proves an incoming "this order is paid" call really came from Razorpay.
# Without it, POST /payments/webhook rejects every request (fails closed).
RAZORPAY_WEBHOOK_SECRET=

# Mira AI assistant. Leave blank to run the assistant in a simple built-in
# reply mode. Add a key to connect the real Claude model.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-4-8

# Seed accounts created by "npm run seed" (change before going live).
SEED_OFFICE_USER=office
SEED_OFFICE_PASSWORD=office123
SEED_REP_ID=REP-204
SEED_REP_PASSWORD=rep123

# --- Indian HTTP SMS gateway (Text2 / TEXTOO style) -------------------------
# Tried before Twilio when SMS_HTTP_URL + SMS_HTTP_KEY + SMS_SENDER_ID are set.
# SMS_TEMPLATE must match the DLT-registered template word for word or the
# operator drops the message; {otp} is the only substitution.
SMS_HTTP_URL=
SMS_HTTP_KEY=
SMS_SENDER_ID=
SMS_ROUTE=1
SMS_TEMPLATE_ID=
SMS_TEMPLATE=Dear Customer Your Login otp is {otp} Text2

# --- DigitalOcean Spaces (object storage for uploaded images) ---------------
# Without these, admin images are stored as base64 inside the database and travel
# through the API on every catalogue sync. With them, only a URL is stored.
# Keys come from the DO control panel: API -> Spaces Keys (NOT the API token).
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=blr1
SPACES_PREFIX=eurostar
# Optional: set to the CDN hostname to serve via DO's CDN instead of the origin.
SPACES_PUBLIC_BASE=
